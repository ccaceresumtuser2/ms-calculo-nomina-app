  <diagram id="excepciones-resiliencia" name="Excepciones y resiliencia">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1620" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p2_1" value="&lt;b&gt;Excepciones y resiliencia&lt;/b&gt; · instancia Resilience4j &quot;empleados&quot;" style="text;html=1;align=left;verticalAlign=top;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p2_2" value="&lt;b&gt;Cadena de Resilience4j&lt;/b&gt; (de afuera hacia adentro)" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="55" width="720" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p2_3" value="&lt;b&gt;@Retry&lt;/b&gt; &amp;nbsp;(capa externa)&lt;br&gt;max-attempts=3 (1 llamada + 2 reintentos)&lt;br&gt;espera 5s, backoff exponencial x2, aleatorio &amp;plusmn;50% &amp;rarr; ~5s, ~10s&lt;br&gt;solo reintenta: ServicioNoDisponibleException, IOException, TimeoutException&lt;br&gt;fallbackMethod = fallbackListarEmpleados" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="720" height="600" as="geometry" />
        </mxCell>
        <mxCell id="p2_4" value="&lt;b&gt;@CircuitBreaker&lt;/b&gt;&lt;br&gt;ventana TIME_BASED 60s · minimo 10 llamadas · abre con &amp;ge;50% fallos&lt;br&gt;llamada lenta &amp;gt; 2s (abre solo si 100% lentas, valor por defecto)&lt;br&gt;OPEN 10s &amp;rarr; 20s &amp;rarr; 40s ... max 120s · HALF_OPEN: 3 llamadas de prueba&lt;br&gt;abierto: lanza CallNotPermittedException sin llamar a :8091" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="70" y="200" width="660" height="460" as="geometry" />
        </mxCell>
        <mxCell id="p2_5" value="&lt;b&gt;@RateLimiter&lt;/b&gt;&lt;br&gt;100 llamadas por segundo · timeout 0 (no espera) &amp;rarr; RequestNotPermitted" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="100" y="320" width="600" height="320" as="geometry" />
        </mxCell>
        <mxCell id="p2_6" value="&lt;b&gt;@Bulkhead&lt;/b&gt;&lt;br&gt;max 1000 llamadas concurrentes · espera max 500ms &amp;rarr; BulkheadFullException" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="130" y="420" width="540" height="200" as="geometry" />
        </mxCell>
        <mxCell id="p2_7" value="&lt;b&gt;EmpleadoConsumoClientImp.listarEmpleados()&lt;/b&gt;&lt;br&gt;EmpleadoCargoRestClient &amp;rarr; GET http://localhost:8091/empleados&lt;br&gt;connect-timeout 2s · read-timeout 5s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="160" y="520" width="480" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2_8" value="&lt;b&gt;Fallback&lt;/b&gt; (cuando @Retry ya no puede mas)&lt;br&gt;fallbackListarEmpleados(ServicioNoDisponibleException) &amp;rarr; motivo &quot;reintentos agotados&quot;&lt;br&gt;fallbackListarEmpleados(CallNotPermittedException) &amp;rarr; motivo &quot;circuito abierto&quot;&lt;br&gt;ambos &amp;rarr; usarUltimaRespuestaOFallar() &amp;rarr; lanza ServicioNoDisponibleException" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="40" y="710" width="720" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2_9" value="" style="html=1;endArrow=block;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="p2_3" target="p2_8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_10" value="&lt;b&gt;Jerarquia de excepciones propias&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="820" width="400" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p2_11" value="RuntimeException" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="845" width="160" height="30" as="geometry" />
        </mxCell>
