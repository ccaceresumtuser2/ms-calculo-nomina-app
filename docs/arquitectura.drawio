          <mxGeometry x="60" y="895" width="200" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p2_13" value="ServicioNoDisponibleException" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="945" width="200" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p2_14" value="RecursoNoEncontradoException" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="500" y="895" width="210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p2_15" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=0;fontSize=10;" edge="1" parent="1" source="p2_12" target="p2_11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_16" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=0;fontSize=10;" edge="1" parent="1" source="p2_14" target="p2_11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_17" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=0;fontSize=10;" edge="1" parent="1" source="p2_13" target="p2_12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_18" value="&lt;b&gt;Mapeo de errores&lt;/b&gt; (EmpleadoConsumoClientImp &amp;rarr; GlobalExceptionHandler)" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="820" y="55" width="760" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p2_19" value="Error de origen" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1">
